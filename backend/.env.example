# Backend Environment Configuration Template
# Copy this file to .env and configure details. Do NOT commit real credentials.

# Port the Express server listens on
PORT=5000

# Connection URI for Mongoose / MongoDB Atlas
MONGODB_URI=mongodb://127.0.0.1:27017/letters

# Secret string used to sign JSON Web Tokens
JWT_SECRET=your_jwt_secret_here

# Access code to authenticate owner dashboard entry
OWNER_PASSWORD=your_owner_password_here

# URL of the hosted frontend (for CORS checks)
FRONTEND_URL=http://localhost:5173
